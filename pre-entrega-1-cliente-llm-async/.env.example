# Copiá este archivo a .env y completá las claves que tengas.
# No hace falta tener las dos: main.py omite el proveedor sin API key.

OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Opcionales: modelo por defecto de cada proveedor.
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
