# Obligatoria solo para la etapa de generación.
OPENAI_API_KEY=sk-...

# Modelo de chat. Los embeddings son locales y no consumen la API de OpenAI.
OPENAI_MODEL=gpt-4o-mini

# Configuración opcional.
CHROMA_COLLECTION_NAME=aulanova_knowledge
CHROMA_PERSIST_DIR=./vectorstore
RAG_DATA_DIR=./data
CHUNK_SIZE=500
CHUNK_OVERLAP=50
RAG_TOP_K=4
RAG_MAX_DISTANCE=0.75
TOKEN_ENCODING=cl100k_base
